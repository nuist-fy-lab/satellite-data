[Unit]
Description=Deploy cloud-verified satellite-data main release to c2ln1
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/satellite-data/auto-deploy.sh
TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
