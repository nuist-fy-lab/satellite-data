# Non-secret runtime configuration.
# IPC sockets default to XDG_RUNTIME_DIR so shared HOME filesystems cannot
# expose one node's listener path to another node. Set absolute paths only when
# overriding the defaults.
# SATDOWN_SOCKET=/run/user/UID/satellite-data-downloader/downloader.sock
SATDOWN_DB=%h/.local/state/satellite-data-downloader/downloader.sqlite3
SATDOWN_DOWNLOAD_ROOT=%h/.local/state/satellite-data-downloader/delivery
SATDOWN_ARCHIVE_ROOT=/misc/nuist_data1/public_sharing/satellite
SATDOWN_EARTHCARE_ARCHIVE_ROOT=/misc/nuist_data1/public_sharing/EarthCare
SATDOWN_ERA5_ARCHIVE_ROOT=/misc/nuist_data1/public_sharing/ERA5
# SATDOWN_ARCHIVE_EVENT_SOCKET=/run/user/UID/satellite-data/archive-events.sock

# Provider-isolated transfer and verification pools.
SATDOWN_GOES_TRANSFER_CONCURRENCY=4
SATDOWN_GOES_VERIFY_CONCURRENCY=2
SATDOWN_MODIS_TRANSFER_CONCURRENCY=4
SATDOWN_MODIS_VERIFY_CONCURRENCY=2
SATDOWN_VIIRS_TRANSFER_CONCURRENCY=4
SATDOWN_VIIRS_VERIFY_CONCURRENCY=2
SATDOWN_MTG_TRANSFER_CONCURRENCY=2
SATDOWN_MTG_VERIFY_CONCURRENCY=1
SATDOWN_EARTHCARE_TRANSFER_CONCURRENCY=2
SATDOWN_EARTHCARE_VERIFY_CONCURRENCY=1
SATDOWN_CALIPSO_TRANSFER_CONCURRENCY=3
SATDOWN_CALIPSO_VERIFY_CONCURRENCY=2
SATDOWN_CLOUDSAT_TRANSFER_CONCURRENCY=2
SATDOWN_CLOUDSAT_VERIFY_CONCURRENCY=2

# H8/H9 intentionally paused until the c2ln1 -> NOAA S3 path is improved.
SATDOWN_HIMAWARI8_ENABLED=true
SATDOWN_HIMAWARI9_ENABLED=true
# Must match SATELLITE_CENTRAL_SOCKET in the centre service. The default is
# XDG_RUNTIME_DIR/satellite-data/central.sock.
# SATDOWN_CENTRAL_SOCKET=/run/user/UID/satellite-data/central.sock
