SATELLITED_ADDR=127.0.0.1:8080
SATELLITED_STATE_DB=%h/.local/state/satellite-data/state.sqlite3
SATELLITED_ARCHIVE=/misc/nuist_data1/public_sharing/satellite
SATELLITED_EARTHCARE_ARCHIVE=/misc/nuist_data1/public_sharing/EarthCare
SATELLITED_ERA5_ARCHIVE=/misc/nuist_data1/public_sharing/ERA5

# Local IPC only. The downloader has a separate runtime/secrets configuration.
SATELLITE_DOWNLOADER_SOCKET=%h/.local/state/satellite-data-downloader/downloader.sock
SATELLITE_ARCHIVE_EVENT_SOCKET=%h/.local/state/satellite-data/archive-events.sock

# Reuse the existing NSMC Data web user/session store so Satellite Data access
# management uses the same administrator credentials.
SATELLITE_AUTH_DB=%h/.local/state/nsmcdata/index.sqlite3
# Optional CDS token: a raw Personal Access Token in a private 0600/0400 file.
# CDS_API_TOKEN_FILE=/etc/satellite-data/cds-token
