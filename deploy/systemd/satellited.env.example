SATELLITED_ADDR=127.0.0.1:8080
SATELLITED_STATE_DB=%h/.local/state/satellite-data/state.db
SATELLITED_ARCHIVE=/misc/nuist_data1/public_sharing/satellite

# Local IPC only. The downloader has a separate runtime/secrets configuration.
SATELLITE_DOWNLOADER_SOCKET=%h/.local/state/satellite-data-downloader/downloader.sock
SATELLITE_ARCHIVE_EVENT_SOCKET=%h/.local/state/satellite-data/archive-events.sock

# Keep Satellite Data authentication state isolated from NSMC Data. Sharing a
# WAL-mode SQLite database across the two long-running services can cause
# cross-service writer contention and I/O failures on shared filesystems.
SATELLITE_AUTH_DB=%h/.local/state/satellite-data/auth.sqlite3
