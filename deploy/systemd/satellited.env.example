SATELLITED_ADDR=127.0.0.1:8080
# Enforce host affinity in code as a second line of defence alongside systemd
# ConditionHost= when HOME is shared across cluster nodes.
# SATELLITE_REQUIRE_HOST=c2ln1
# Do NOT use systemd %h specifiers inside EnvironmentFile=; leave unset to use
# $XDG_STATE_HOME/satellite-data/state.sqlite3 (~/.local/state/...) or set an
# explicit absolute path.
# SATELLITED_STATE_DB=/path/to/state.sqlite3
SATELLITED_ARCHIVE=/misc/nuist_data1/public_sharing/satellite
SATELLITED_EARTHCARE_ARCHIVE=/misc/nuist_data1/public_sharing/EarthCare
SATELLITED_ERA5_ARCHIVE=/misc/nuist_data1/public_sharing/ERA5

# Local IPC only. By default these sockets live under XDG_RUNTIME_DIR, not the
# home/state tree. This matters on clusters where HOME is shared across nodes.
# Set absolute paths only when the deployment needs to override those defaults.
# SATELLITE_DOWNLOADER_SOCKET=/run/user/UID/satellite-data-downloader/downloader.sock
# SATELLITE_ARCHIVE_EVENT_SOCKET=/run/user/UID/satellite-data/archive-events.sock
# SATELLITE_CENTRAL_SOCKET=/run/user/UID/satellite-data/central.sock

# Keep Satellite Data authentication state isolated from NSMC Data. Sharing a
# WAL-mode SQLite database across the two long-running services can cause
# cross-service writer contention and I/O failures on shared filesystems.
# Leave unset for ~/.local/state/satellite-data/auth.sqlite3 or set an absolute path.
# SATELLITE_AUTH_DB=/path/to/auth.sqlite3
# Optional CDS token: a raw Personal Access Token in a private 0600/0400 file.
# CDS_API_TOKEN_FILE=/etc/satellite-data/cds-token
